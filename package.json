{
  "name": "grouplock-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "GroupLock - Shared focus rooms with real-time accountability",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start:frontend": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start",
    "db:schema": "npm --prefix backend run db:schema"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
